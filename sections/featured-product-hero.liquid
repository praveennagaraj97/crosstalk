{% liquid
  assign hero_product = section.settings.featured_product
  assign hero_url = routes.all_products_collection_url
  assign image_overlay_alpha = section.settings.image_overlay_opacity | divided_by: 100.0
  assign image_overlay_color = section.settings.image_overlay_color | color_modify: 'alpha', image_overlay_alpha
  if hero_product != blank
    assign hero_url = hero_product.url
  endif
%}

<section
  class="relative overflow-hidden bg-[#7d8060] lg:min-h-0"
  data-navigation-product-handle="{{ hero_product.handle | escape }}"
  style="--hero-image-overlay: {{ image_overlay_color }};"
  aria-label="{{ section.settings.heading_line_1 | append: ' ' | append: section.settings.heading_line_2 | append: ' ' | append: section.settings.heading_line_3 | escape }}"
>
  {% comment %} Component: Campaign artwork {% endcomment %}
  {% if section.settings.campaign_image != blank %}
    {{ section.settings.campaign_image | image_url: width: 2400 | image_tag: class: 'absolute inset-0 size-full object-cover object-center', widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
  {% else %}
    <img class="absolute inset-0 size-full object-cover object-[45%_center] lg:object-center" src="{{ 'amaari-radiance-hero.png' | asset_url }}" width="1024" height="1024" fetchpriority="high" alt="">
  {% endif %}
  {% if section.settings.show_image_overlay %}
    <div class="absolute inset-0 bg-(--hero-image-overlay)" data-hero-image-overlay aria-hidden="true"></div>
  {% endif %}

  {% comment %} Component: Campaign content {% endcomment %}
  <div class="container relative z-10 mx-auto flex w-full px-4 pt-30 pb-12 lg:pt-34 lg:pb-12">
    <div class="max-w-88 lg:max-w-120" data-reveal-group>
      {% if section.settings.eyebrow != blank %}
        <p class="inline-flex rounded-full border border-toasted-almond px-2.5 py-1.5 text-[10px] leading-3 font-semibold tracking-[0.9px] text-toasted-almond uppercase lg:px-3 lg:py-2 lg:text-xs lg:leading-3.5">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="mt-3 font-display text-[2.5rem] leading-[1.08] font-normal text-text-brown lg:text-[clamp(3.5rem,5.56vw,5rem)] lg:leading-[1.19]" aria-label="{{ section.settings.heading_line_1 | append: ' ' | append: section.settings.heading_line_2 | append: ' ' | append: section.settings.heading_line_3 | strip_newlines | escape }}">
        <span class="block w-fit">{{ section.settings.heading_line_1 | escape }}</span>
        <span class="block w-fit text-toasted-almond [text-shadow:0_3px_5px_rgb(166_114_105/24%),0_1px_1px_rgb(255_255_255/35%)]">{{ section.settings.heading_line_2 | escape }}</span>
        <span class="block w-fit whitespace-pre-line">{{ section.settings.heading_line_3 | escape }}</span>
      </h1>
      {% if section.settings.description != blank %}<div class="mt-3 max-w-96 text-sm leading-6 font-normal tracking-[0.3px] text-toasted-almond lg:mt-4 lg:max-w-120 lg:text-lg lg:leading-7.5">{{ section.settings.description }}</div>{% endif %}
      {% if section.settings.cta_label != blank %}
        <a class="chrome-action relative mt-3 inline-flex min-h-12 items-center justify-center overflow-hidden rounded-full bg-[linear-gradient(148deg,#2d1f1e,#9b685b_50%,#4e3b37)] px-6 py-3.5 text-center text-sm leading-5 font-semibold tracking-[1.2px] text-[#f4dfb8] uppercase shadow-[0_4px_6px_-1px_rgb(166_114_105/24%),inset_0_1px_1px_1px_rgb(255_255_255/35%)] transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white lg:mt-5.5 lg:min-h-14 lg:w-72.5 lg:px-8 lg:text-base" href="{{ hero_url }}"><span class="relative z-10 whitespace-nowrap">{{ section.settings.cta_label | escape }}</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product hero",
  "tag": "section",
  "class": "featured-product-hero-section",
  "settings": [
    { "type": "image_picker", "id": "campaign_image", "label": "Campaign image" },
    { "type": "checkbox", "id": "show_image_overlay", "label": "Enable image overlay", "default": true },
    { "type": "color", "id": "image_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "image_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 15 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Introducing The Ritual" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "SMART" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "FORMULAS." },
    { "type": "textarea", "id": "heading_line_3", "label": "Heading line 3", "default": "SIMPLE\nROUTINE." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Experience the storytelling rhythm of earthy-luxury skincare. Seeded in science, rooted in nature.</p>" },
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the Radiance Oil" }
  ],
  "presets": [{ "name": "Featured product hero" }]
}
{% endschema %}
