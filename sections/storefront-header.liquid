{% liquid
  assign navigation_products = section.settings.products
  assign ingredients_page = pages[section.settings.ingredients_page]
  if ingredients_page == blank
    assign ingredients_page = pages['ingredients']
  endif

  assign active_nav = blank
  assign context_product = blank
  assign surface = 'light'
  assign header_background = section.settings.default_background

  if request.page_type == 'product'
    assign active_nav = 'shop'
    assign context_product = product
    assign header_background = section.settings.product_background
  elsif request.page_type == 'index'
    assign surface = 'dark'
    assign header_background = section.settings.featured_background
  elsif request.page_type == 'page'
    assign active_nav = page.handle
    if page.template_suffix == 'ingredients'
      assign active_nav = 'ingredients'
      assign header_background = section.settings.ingredients_background
    elsif page.template_suffix contains 'featured'
      assign surface = 'dark'
      assign active_nav = 'shop'
      assign header_background = section.settings.featured_background
    endif
  endif
%}

<style>body { background-color: {{ header_background }}; }</style>

{% comment %} Component: Global announcement marquee {% endcomment %}
{% if section.settings.show_marquee %}
  <div class="h-8 overflow-hidden border-b border-white/30 bg-white/55 text-pecan-brown shadow-[0_4px_50px_-12px_rgb(0_0_0/12%)] backdrop-blur-xl lg:h-10" aria-label="Promotions">
    {% capture global_marquee_items %}
      {% assign announcement_items = section.settings.announcement_text | newline_to_br | split: '<br />' %}
      {% for announcement in announcement_items %}
        {% if announcement != blank %}<span class="flex shrink-0 items-center gap-7 whitespace-nowrap text-xs leading-5 tracking-[0.4px] lg:text-base lg:leading-6"><span>{{ announcement | strip | escape }}</span><span class="size-1.5 shrink-0 rounded-full bg-current" aria-hidden="true"></span></span>{% endif %}
      {% endfor %}
    {% endcapture %}
    <div class="marquee-track flex h-full w-max items-center" tabindex="0" style="--hero-marquee-duration: {{ section.settings.marquee_speed }}s">
      <div class="flex shrink-0 items-center gap-8 pr-8">{{ global_marquee_items }}</div>
      <div class="marquee-copy flex shrink-0 items-center gap-8 pr-8" aria-hidden="true">{{ global_marquee_items }}</div>
    </div>
  </div>
{% endif %}

{% comment %} Component: Sticky glass navigation {% endcomment %}
<section class="global-storefront-header-shell {% if surface == 'dark' %}global-storefront-header-shell--overlay{% endif %} pb-3 lg:pb-4" data-global-storefront-header>
  {% render 'storefront-navigation', nav_settings: section.settings, nav_products: navigation_products, active_nav: active_nav, surface: surface, context_product: context_product, ingredient_page: ingredients_page %}
</section>

{% schema %}
{
  "name": "Global storefront header",
  "class": "global-storefront-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu" },
    { "type": "page", "id": "ingredients_page", "label": "Ingredients page" },
    { "type": "product_list", "id": "products", "label": "Product menu", "limit": 24 },
    { "type": "text", "id": "shop_label", "label": "Product menu label", "default": "Shop All" },
    { "type": "text", "id": "navigation_search_placeholder", "label": "Search placeholder", "default": "Find your glow" },
    { "type": "header", "content": "Announcement marquee" },
    { "type": "checkbox", "id": "show_marquee", "label": "Show announcement marquee", "default": true },
    { "type": "textarea", "id": "announcement_text", "label": "Announcements (one per line)", "default": "New product drop in 6hrs\nSuitable for all skin types\nFirst time users get 10% OFF\nPromo code FIRST10" },
    { "type": "range", "id": "marquee_speed", "label": "Announcement speed", "min": 10, "max": 60, "step": 5, "unit": "s", "default": 30 },
    { "type": "header", "content": "Page surfaces" },
    { "type": "color", "id": "default_background", "label": "Default page header", "default": "#f8f7f6" },
    { "type": "color", "id": "product_background", "label": "Product page header", "default": "#f5ebe1" },
    { "type": "color", "id": "ingredients_background", "label": "Ingredients page header", "default": "#f8f7f6" },
    { "type": "color", "id": "featured_background", "label": "Featured page header", "default": "#7d8060" }
  ]
}
{% endschema %}
