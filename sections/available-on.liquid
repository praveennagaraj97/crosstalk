{% comment %} Component: Marketplace availability {% endcomment %}
<section class="bg-[#f4f3f3] py-10 sm:py-12 lg:py-14" aria-labelledby="AvailableOnHeading-{{ section.id }}">
  <div class="container mx-auto px-4 text-center" data-reveal-group>
    {% if section.settings.heading != blank %}
      <h2 id="AvailableOnHeading-{{ section.id }}" class="font-display text-xl leading-7 font-normal italic text-pecan-brown sm:text-2xl">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
      {% for block in section.blocks %}
        {% liquid
          assign logo_image = block.settings.image
          assign logo_url = block.settings.url
          assign logo_alt = block.settings.name | default: 'Marketplace'
          assign logo_classes = 'grid h-8 w-20 shrink-0 place-items-center overflow-hidden px-1'
        %}
        {% capture logo_content %}
          {% if logo_image != blank %}
            {{ logo_image | image_url: height: 80 | image_tag: class: 'h-full w-full object-contain', widths: '80, 160', loading: 'lazy', alt: logo_alt }}
          {% elsif block.settings.asset_filename != blank %}
            <img class="h-full w-full object-contain" src="{{ block.settings.asset_filename | asset_url }}" width="80" height="40" loading="lazy" alt="{{ logo_alt | escape }}">
          {% endif %}
        {% endcapture %}
        {% if logo_url != blank %}
          <a href="{{ logo_url }}" class="{{ logo_classes }} focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bitter-chocolate" rel="noopener noreferrer" target="_blank" {{ block.shopify_attributes }}>{{ logo_content }}</a>
        {% else %}
          <span class="{{ logo_classes }}" {{ block.shopify_attributes }}>{{ logo_content }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Also available on",
  "tag": "section",
  "class": "available-on-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Also available on" }
  ],
  "blocks": [
    {
      "type": "marketplace",
      "name": "Marketplace",
      "settings": [
        { "type": "text", "id": "name", "label": "Marketplace name", "default": "Marketplace" },
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "asset_filename", "label": "Theme asset fallback filename", "default": "amazon-logo.png", "info": "Used when no logo is selected above." },
        { "type": "url", "id": "url", "label": "Marketplace URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Also available on",
      "blocks": [
        { "type": "marketplace", "settings": { "name": "Amazon", "asset_filename": "amazon-logo.png", "url": "https://www.amazon.in/" } },
        { "type": "marketplace", "settings": { "name": "Tira", "asset_filename": "tira-logo.webp", "url": "https://www.tirabeauty.com/" } },
        { "type": "marketplace", "settings": { "name": "Nykaa", "asset_filename": "nykaa-logo.svg", "url": "https://www.nykaafashion.com/" } },
        { "type": "marketplace", "settings": { "name": "Purplle", "asset_filename": "purplle-logo.svg", "url": "https://www.purplle.com/" } }
      ]
    }
  ]
}
{% endschema %}
