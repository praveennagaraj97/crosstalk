<section class="bg-[#f5ebe1] py-12 lg:py-16" aria-labelledby="ReviewsTitle-{{ section.id }}">
  <div class="container mx-auto px-4">
    <header class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between" data-reveal-group>
      <div><h2 id="ReviewsTitle-{{ section.id }}" class="font-display text-4xl lg:text-5xl">{{ section.settings.heading | escape }}</h2><div class="mt-3 flex items-center gap-4"><span class="text-xl tracking-[4px] text-pecan-brown" aria-hidden="true">★★★★★</span><span class="text-sm">{{ section.settings.summary | escape }}</span></div></div>
      <a class="chrome-action relative inline-flex min-h-11 items-center justify-center overflow-hidden rounded-full border border-bitter-chocolate px-7 text-xs font-bold tracking-[1.3px] uppercase" href="#judgeme_product_reviews"><span class="relative z-10">{{ section.settings.write_label | escape }}</span></a>
    </header>
    <div class="mt-8 grid gap-5 rounded-2xl border border-pecan-brown/15 bg-white/35 p-6 sm:grid-cols-3" data-reveal-group>
      {% assign score_labels = section.settings.score_labels | split: '|' %}{% assign score_values = section.settings.score_values | split: '|' %}
      {% for score_label in score_labels limit: 3 %}{% assign score = score_values[forloop.index0] | default: 90 %}<div><div class="flex items-center justify-between text-xs font-semibold tracking-[1px] uppercase"><span>{{ score_label | strip | escape }}</span><span>{{ score | strip }}%</span></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-pecan-brown/15"><span class="block h-full rounded-full bg-bitter-chocolate" style="width: {{ score | strip }}%"></span></div></div>{% endfor %}
    </div>
    <div class="mt-8 flex snap-x gap-4 overflow-x-auto pb-3" aria-label="Community highlights" data-reveal-group>
      {% assign community_count = 0 %}
      {% for block in section.blocks %}{% if block.type == 'community_image' %}{% assign community_count = community_count | plus: 1 %}<figure class="aspect-[3/4] w-48 shrink-0 snap-start overflow-hidden rounded-xl bg-white/50" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 520 | image_tag: class: 'size-full object-cover', widths: '240, 360, 520', loading: 'lazy', alt: block.settings.alt }}{% endif %}</figure>{% endif %}{% endfor %}
      {% if community_count == 0 %}{% for i in (1..6) %}{% capture fallback_asset %}instagram-feed-0{{ i }}.png{% endcapture %}<figure class="aspect-[3/4] w-48 shrink-0 snap-start overflow-hidden rounded-xl"><img class="size-full object-cover" src="{{ fallback_asset | asset_url }}" width="192" height="256" loading="lazy" alt="Amaari community highlight {{ i }}"></figure>{% endfor %}{% endif %}
    </div>
    {% assign app_count = 0 %}{% for block in section.blocks %}{% if block.type == '@app' %}{% assign app_count = app_count | plus: 1 %}{% endif %}{% endfor %}
    {% if app_count > 0 %}<div class="mt-8" id="judgeme_product_reviews">{% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}</div>{% else %}<p class="mt-8 rounded-xl border border-pecan-brown/15 bg-white/40 p-8 text-center text-sm text-bitter-chocolate" id="judgeme_product_reviews">{{ section.settings.empty_text | escape }}</p>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Product reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"Customer Reviews"},{"type":"text","id":"summary","label":"Fallback summary","default":"Loved by the Amaari community"},{"type":"textarea","id":"score_labels","label":"Score labels separated by |","default":"Efficacy|Texture|Scent"},{"type":"text","id":"score_values","label":"Score percentages separated by |","default":"98|95|92"},{"type":"text","id":"write_label","label":"Write review label","default":"Write a Review"},{"type":"textarea","id":"empty_text","label":"Empty message","default":"Reviews will appear here once the Judge.me app block is added."}],"blocks":[{"type":"@app"},{"type":"community_image","name":"Community image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Alt text","default":"Amaari community result"}]}],"presets":[{"name":"Product reviews"}]}
{% endschema %}
