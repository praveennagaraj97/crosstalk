{% liquid
  assign fallback_social_icons = 'I198-7726-285-3709.svg|I198-7726-285-3524.svg|I198-7726-285-3577.svg' | split: '|'
  assign social_names = 'Instagram|Facebook|Twitter' | split: '|'
  assign legal_labels = section.settings.legal_label_1 | append: '|' | append: section.settings.legal_label_2 | append: '|' | append: section.settings.legal_label_3 | split: '|'
  assign legal_urls = section.settings.legal_url_1 | append: '|' | append: section.settings.legal_url_2 | append: '|' | append: section.settings.legal_url_3 | split: '|'
  assign footer_logo = section.settings.logo
%}

<footer class="overflow-hidden bg-bitter-chocolate py-8 text-white">
  <div class="container mx-auto w-full px-4">
    <div class="flex flex-col items-start justify-between gap-8 lg:min-h-66.25 lg:flex-row lg:gap-20" data-reveal-group>
      {% comment %} Component: Brand {% endcomment %}
      <div class="w-full lg:w-111">
        {% if footer_logo != blank %}
          <span>
            {{ footer_logo | image_url: width: 232 | image_tag: class: 'h-7.25 w-29 object-contain', widths: '116, 232', loading: 'lazy', alt: shop.name }}
          </span>
        {% else %}
          <img class="h-7.25 w-29 object-contain" src="{{ 'main-brand-logo.png' | asset_url }}" width="116" height="29" loading="lazy" alt="{{ shop.name | escape }}">
        {% endif %}

        <p class="mt-4 max-w-111 font-display text-xl leading-7 font-normal italic">{{ section.settings.tagline | escape }}</p>

        {% comment %} Component: Social links {% endcomment %}
        <div class="mt-4 flex gap-3">
          {% for index in (1..3) %}
            {% liquid
              assign social_index = forloop.index0
              case index
                when 1
                  assign social_url = section.settings.instagram_url
                when 2
                  assign social_url = section.settings.facebook_url
                else
                  assign social_url = section.settings.twitter_url
              endcase
            %}
            {% if social_url != blank %}
              <a class="footer-tile-interactive grid size-10 place-items-center rounded-full border border-white hover:text-logo focus-visible:text-logo" href="{{ social_url }}" aria-label="{{ social_names[social_index] }}" rel="noopener noreferrer" target="_blank">
                <img class="size-3.5" src="{{ fallback_social_icons[social_index] | asset_url }}" width="14" height="14" loading="lazy" alt="">
              </a>
            {% else %}
              <span class="footer-tile-interactive grid size-10 place-items-center rounded-full border border-white" aria-hidden="true">
                <img class="size-3.5" src="{{ fallback_social_icons[social_index] | asset_url }}" width="14" height="14" loading="lazy" alt="">
              </span>
            {% endif %}
          {% endfor %}
        </div>

      </div>

      {% comment %} Component: Navigation {% endcomment %}
      <nav class="w-full lg:w-43.75 lg:self-center" aria-label="{{ section.settings.menu_heading | escape }}">
        <h2 class="mb-3 font-sans text-sm leading-5 font-medium uppercase lg:text-base lg:leading-6">{{ section.settings.menu_heading | escape }}</h2>
        {% if section.settings.discover_menu != blank %}
          <ul class="grid list-none gap-1.5 p-0">
            {% for link in section.settings.discover_menu.links %}
              <li><a class="footer-link-interactive font-sans text-sm leading-5 font-light no-underline lg:text-base lg:leading-6" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>
    </div>

    {% comment %} Component: Legal {% endcomment %}
    <div class="mt-6 flex flex-col items-start justify-between gap-5 border-t border-white pt-6 lg:flex-row lg:items-center lg:gap-8 lg:pt-8" data-reveal-group>
      {% if section.settings.legal_menu != blank %}
        <nav aria-label="Legal">
          <ul class="flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
            {% for link in section.settings.legal_menu.links %}
              <li><a class="footer-link-interactive font-sans text-[11px] leading-4 font-light tracking-[0.8px] uppercase no-underline" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% else %}
        <nav aria-label="Legal">
          <ul class="flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
            {% for legal_label in legal_labels %}
              {% if legal_label != blank %}
                <li>
                  {% if legal_urls[forloop.index0] != blank %}
                    <a class="footer-link-interactive font-sans text-[11px] leading-4 font-light tracking-[0.8px] uppercase no-underline" href="{{ legal_urls[forloop.index0] }}">{{ legal_label | escape }}</a>
                  {% else %}
                    <span class="footer-link-interactive font-sans text-[11px] leading-4 font-light tracking-[0.8px] uppercase">{{ legal_label | escape }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
      <div class="flex flex-col gap-2 font-sans text-[11px] leading-4 font-light tracking-[0.4px] sm:flex-row sm:items-center sm:gap-4">
        <p>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</p>
        <span class="hidden text-white/60 sm:inline" aria-hidden="true">|</span>
        <p>Designed &amp; Developed by <a class="footer-link-interactive underline underline-offset-2" href="https://www.zartek.in" rel="noopener noreferrer" target="_blank">Zartek</a></p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Light logo (match header)" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Synthesizing nature and science to create a new standard of high-performance, sensory skincare." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "twitter_url", "label": "Twitter URL" },
    { "type": "text", "id": "menu_heading", "label": "Menu heading", "default": "Discover" },
    { "type": "link_list", "id": "discover_menu", "label": "Discover menu" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu" },
    { "type": "text", "id": "legal_label_1", "label": "Legal item 1 label", "default": "Privacy Policy" },
    { "type": "url", "id": "legal_url_1", "label": "Legal item 1 URL" },
    { "type": "text", "id": "legal_label_2", "label": "Legal item 2 label", "default": "Terms of Service" },
    { "type": "url", "id": "legal_url_2", "label": "Legal item 2 URL" },
    { "type": "text", "id": "legal_label_3", "label": "Legal item 3 label", "default": "Shipping & Returns" },
    { "type": "url", "id": "legal_url_3", "label": "Legal item 3 URL" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "Crosstalk Collective. All Rights Reserved." }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
