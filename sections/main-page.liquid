{% comment %}
  Main page
  ---------
  Shopify provides `page` for any Page created in Admin. This section renders
  that page's title and rich-text content before the page-specific modules.
{% endcomment %}

<section class="main-page">
  <div class="page-width">
    <h1>{{ page.title | escape }}</h1>
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
