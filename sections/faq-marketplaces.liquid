{% liquid
  assign fallback_badges = 'nykaa-logo.svg|tira-logo.webp|amazon-logo.png|purplle-logo.svg' | split: '|'
  assign badge_names = 'Nykaa|Tira|Amazon|Purplle' | split: '|'
%}

{% comment %} Component: Marketplace availability {% endcomment %}
<section class="bg-background px-4 py-8 sm:py-10" aria-labelledby="FaqMarketplaces-{{ section.id }}">
  <div class="container mx-auto text-center">
    <h2 id="FaqMarketplaces-{{ section.id }}" class="font-display text-3xl leading-9 font-normal text-bitter-chocolate sm:text-4xl">{{ section.settings.heading | escape }}</h2>
    <div class="mt-5 flex items-center justify-center gap-3">
      {% for index in (1..4) %}
        {% liquid
          assign image_key = 'badge_' | append: index | append: '_image'
          assign url_key = 'badge_' | append: index | append: '_url'
          assign badge_image = section.settings[image_key]
          assign badge_url = section.settings[url_key]
        %}
        {% capture badge_content %}
          {% if badge_image != blank %}
            {{ badge_image | image_url: height: 80 | image_tag: class: 'h-full w-full object-contain', widths: '80, 160', loading: 'lazy', alt: badge_names[forloop.index0] }}
          {% else %}
            <img class="h-full w-full object-contain" src="{{ fallback_badges[forloop.index0] | asset_url }}" width="80" height="40" loading="lazy" alt="{{ badge_names[forloop.index0] }}">
          {% endif %}
        {% endcapture %}
        {% assign badge_classes = 'grid h-10 shrink-0 place-items-center overflow-hidden rounded-lg px-2 py-1.5' %}
        {% case index %}
          {% when 1 %}{% assign badge_classes = badge_classes | append: ' w-20 bg-[linear-gradient(135deg,#e82831,#e84232_60%,#f49b5e)] [&>img]:brightness-0 [&>img]:invert' %}
          {% when 2 %}{% assign badge_classes = badge_classes | append: ' w-10 bg-[#f9dcd4] [&>img]:mix-blend-multiply' %}
          {% when 3 %}{% assign badge_classes = badge_classes | append: ' w-12.5 bg-white' %}
          {% else %}{% assign badge_classes = badge_classes | append: ' w-16.25 bg-white' %}
        {% endcase %}
        {% if badge_url != blank %}
          <a href="{{ badge_url }}" class="{{ badge_classes }}" rel="noopener noreferrer" target="_blank">{{ badge_content }}</a>
        {% else %}
          <span class="{{ badge_classes }}">{{ badge_content }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ marketplaces",
  "tag": "section",
  "class": "faq-marketplaces-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Also available on" },
    { "type": "image_picker", "id": "badge_1_image", "label": "Nykaa logo" },
    { "type": "url", "id": "badge_1_url", "label": "Nykaa link" },
    { "type": "image_picker", "id": "badge_2_image", "label": "Tira logo" },
    { "type": "url", "id": "badge_2_url", "label": "Tira link" },
    { "type": "image_picker", "id": "badge_3_image", "label": "Amazon logo" },
    { "type": "url", "id": "badge_3_url", "label": "Amazon link" },
    { "type": "image_picker", "id": "badge_4_image", "label": "Purplle logo" },
    { "type": "url", "id": "badge_4_url", "label": "Purplle link" }
  ],
  "presets": [{ "name": "FAQ marketplaces" }]
}
{% endschema %}
