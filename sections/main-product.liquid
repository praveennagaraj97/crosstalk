{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign collection_label = product.metafields.custom.collection_label.value | default: section.settings.collection_label
  assign editorial_quote = product.metafields.custom.editorial_quote.value | default: section.settings.editorial_quote
  assign ingredient_items = product.metafields.custom.ingredient_highlights.value | default: product.metafields.custom.ingredients.value
  assign product_standards = product.metafields.custom.standards.value
  assign primary_form_id = 'ProductForm-' | append: section.id
%}

<section class="bg-[#f5ebe1] pb-14 lg:pb-20" data-main-product data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="container mx-auto grid items-start gap-8 px-4 pt-5 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-8 lg:pt-10">
    {% comment %} Component: Sticky product gallery {% endcomment %}
    <div class="w-full lg:sticky lg:top-5" data-product-gallery data-reveal-group>
      <div class="relative aspect-[788/770] overflow-hidden rounded-[20px] bg-[#eee6df]" data-gallery-stage>
        {% if product.media.size > 0 %}{% for media in product.media %}
          <div class="absolute inset-0 transition-opacity duration-300 {% unless media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}pointer-events-none opacity-0{% endunless %}" data-media-id="{{ media.id }}" {% unless media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}hidden{% endunless %}>
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 1600 | image_tag: class: 'size-full object-cover', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1024px) 55vw, 100vw', loading: 'eager', alt: media.alt | default: product.title }}
              {% when 'video' %}{{ media | media_tag: image_size: '1200x', autoplay: false, loop: true, controls: true, class: 'size-full object-cover' }}
              {% when 'external_video' %}{{ media | external_video_tag: class: 'size-full' }}
              {% when 'model' %}{{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'size-full' }}
            {% endcase %}
          </div>
        {% endfor %}{% else %}<div class="grid size-full place-items-center text-sm text-bitter-chocolate/60">{{ 'product-1' | placeholder_svg_tag: 'size-full' }}</div>{% endif %}
        <div class="absolute inset-x-0 bottom-0 overflow-hidden bg-[#5a2e2c]/90 py-2.5 text-white backdrop-blur-lg" aria-hidden="true">
          <div class="pdp-marquee flex w-max gap-10 whitespace-nowrap text-[10px] font-semibold tracking-[2.5px] uppercase">
            {% for i in (1..8) %}<span>{{ section.settings.gallery_marquee | escape }}</span>{% endfor %}
          </div>
        </div>
      </div>
      {% if product.media.size > 1 %}
        <div class="mt-4 grid grid-cols-4 gap-4" role="list" aria-label="Product media">
          {% for media in product.media limit: 4 %}
            <button class="aspect-[185/137] overflow-hidden rounded-[20px] border-2 bg-[#eee6df] transition focus:outline-none focus-visible:ring-2 focus-visible:ring-bitter-chocolate {% if media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}border-bitter-chocolate{% else %}border-transparent opacity-70 hover:opacity-100{% endif %}" type="button" data-gallery-thumb="{{ media.id }}" aria-label="Show media {{ forloop.index }}" aria-pressed="{% if media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 420 | image_tag: class: 'size-full object-cover', widths: '180, 300, 420', loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% comment %} Component: Product purchase and editorial content {% endcomment %}
    <div class="min-w-0" data-product-content>
      <div class="grid gap-4" data-reveal-group>
        {% if collection_label != blank %}<p class="text-xs font-semibold leading-[15px] tracking-[1px] text-bitter-chocolate uppercase">{{ collection_label | escape }}</p>{% endif %}
        <h1 class="font-display text-[40px] leading-none font-normal text-text-brown lg:text-[48px]">{{ product.title | escape }}</h1>
        <div class="flex items-center gap-4">
          <span class="text-xl font-medium tracking-[1px]" data-product-price>{{ current_variant.price | money }}</span>
          <s class="text-sm text-bitter-chocolate/55" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        </div>
        {% if editorial_quote != blank %}<p class="pb-2 text-base leading-7 italic text-bitter-chocolate">“{{ editorial_quote | remove: '“' | remove: '”' | remove: '"' }}”</p>{% endif %}
        {% if product.description != blank %}<div class="rte text-sm leading-6 text-bitter-chocolate/85" data-product-description>{{ product.description }}</div>{% endif %}
      </div>

      {% form 'product', product, id: primary_form_id, class: 'mt-4 grid gap-8', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1" data-form-quantity>

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="order-2" data-option-group data-option-index="{{ forloop.index0 }}">
              <legend class="mb-3 text-xs font-medium tracking-[1.5px] uppercase">{{ section.settings.select_label }} {{ option.name | escape }}</legend>
              <div class="flex flex-wrap gap-3">
                {% for value in option.values %}
                  {% assign option_selected = false %}
                  {% if value == option.selected_value %}{% assign option_selected = true %}{% endif %}
                  {% assign option_downcase = option.name | downcase %}
                  {% if option_downcase contains 'color' or option_downcase contains 'colour' or option_downcase contains 'shade' %}
                    {% assign swatch_color = value.swatch.color | default: '#c9a68e' %}
                    <button class="pdp-option pdp-swatch grid justify-items-center gap-1.5 text-[11px] tracking-[.8px] uppercase {% if option_selected %}is-selected{% endif %}" type="button" data-option-value="{{ value | escape }}" aria-pressed="{{ option_selected }}"><span class="grid size-11 place-items-center rounded-full border-2 {% if option_selected %}border-bitter-chocolate{% else %}border-transparent{% endif %}" data-swatch-ring><span class="size-8 rounded-full border border-pecan-brown/30" style="background-color: {{ swatch_color }}" aria-hidden="true"></span></span><span>{{ value | escape }}</span></button>
                  {% else %}
                    <button class="pdp-option min-h-12 min-w-28 rounded-full border-2 px-6 text-xs font-semibold tracking-[1px] uppercase {% if option_selected %}is-selected border-bitter-chocolate bg-pecan-brown/5{% else %}border-toasted-almond text-bitter-chocolate{% endif %}" type="button" data-option-value="{{ value | escape }}" aria-pressed="{{ option_selected }}">{{ value | escape }}</button>
                  {% endif %}
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}

        <div class="order-1 flex flex-wrap items-center gap-3" data-primary-purchase>
          <div class="flex h-11 items-center rounded-full border border-toasted-almond px-3" data-quantity-control>
            <button class="grid size-7 place-items-center" type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
            <output class="w-8 text-center text-sm font-semibold" data-quantity-output>1</output>
            <button class="grid size-7 place-items-center" type="button" data-quantity-plus aria-label="Increase quantity">+</button>
          </div>
          <button class="grid size-11 shrink-0 cursor-not-allowed place-items-center rounded-full border-2 border-bitter-chocolate/70 text-lg" type="button" disabled aria-label="Wishlist unavailable" title="Wishlist coming soon">♡</button>
          <button class="chrome-action relative h-11 min-w-32 flex-1 overflow-hidden rounded-full border-2 border-bitter-chocolate bg-transparent px-4 text-[10px] font-bold tracking-[1.1px] text-bitter-chocolate uppercase disabled:cursor-not-allowed disabled:opacity-50" type="submit" name="add" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}><span data-add-label>{% if current_variant.available %}{{ section.settings.add_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span></button>
          <div class="shopify-payment-button-wrap min-w-36 flex-1">{{ form | payment_button }}</div>
        </div>
        <p class="sr-only" data-inventory-status>{% if current_variant.available %}{{ section.settings.in_stock_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</p>
      {% endform %}

      {% comment %} Component: Ingredient highlights {% endcomment %}
      {% if ingredient_items != blank %}<section class="mt-10" data-reveal-group>
        <div class="border-b border-pecan-brown/15 pb-4"><h2 class="font-display text-3xl font-light">{{ section.settings.ingredients_heading | escape }}</h2></div>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {% for ingredient in ingredient_items limit: 4 %}
            {% assign ingredient_image = ingredient.card_image.value | default: ingredient.image.value %}
            <article class="text-center"><div class="mx-auto size-16 overflow-hidden rounded-full bg-[#f1ddcc]">{% if ingredient_image != blank %}{{ ingredient_image | image_url: width: 240 | image_tag: class: 'size-full object-cover', loading: 'lazy', alt: ingredient.image_alt.value | default: ingredient.name.value }}{% endif %}</div><h3 class="mt-3 text-[11px] font-bold tracking-[.7px] uppercase">{{ ingredient.name.value | default: ingredient.system.handle | escape }}</h3><p class="mt-1 text-[9px] leading-4 tracking-[.6px] text-bitter-chocolate uppercase">{{ ingredient.summary.value | truncatewords: 7 }}</p></article>
          {% endfor %}
        </div>
      </section>{% endif %}

      {% comment %} Component: Certifications and testing {% endcomment %}
      {% if product_standards != blank %}<section class="mt-10 border-t border-pecan-brown/15 pt-10" data-reveal-group>
        <p class="text-xs font-semibold tracking-[1.5px] text-bitter-chocolate uppercase">{{ section.settings.standards_eyebrow | escape }}</p>
        <h2 class="mt-2 font-display text-4xl">{{ section.settings.standards_heading | escape }}</h2>
        <div class="mt-7 grid grid-cols-2 gap-x-8 gap-y-7">
          {% for standard in product_standards %}<div class="flex items-center gap-2"><span class="grid size-[42px] shrink-0 place-items-center rounded-full border border-toasted-almond text-sm">✓</span><span class="text-sm">{{ standard | escape }}</span></div>{% endfor %}
        </div>
        {% if product.metafields.custom.standards_note.value != blank %}<p class="mt-7 text-xs leading-5 font-medium tracking-[.4px] text-pecan-brown uppercase">{{ product.metafields.custom.standards_note.value | escape }}</p>{% endif %}
      </section>{% endif %}

      {% comment %} Component: Proven efficacy {% endcomment %}
      {% assign before_image = product.metafields.custom.before_image.value %}
      {% assign after_image = product.metafields.custom.after_image.value %}
      {% if before_image != blank and after_image != blank %}
        <section class="mt-12 border-t border-pecan-brown/15 pt-10" data-reveal-group>
          <h2 class="font-display text-[34px] leading-[42px] font-normal">{{ section.settings.efficacy_heading | escape }}</h2>
          <div class="relative mt-5 aspect-[2/1] overflow-hidden rounded-xl bg-[#eee6df]" data-comparison>
            {{ before_image | image_url: width: 1000 | image_tag: class: 'absolute inset-0 size-full object-cover', widths: '480, 720, 1000', loading: 'lazy', alt: section.settings.before_label }}
            <div class="absolute inset-y-0 right-0 w-1/2 overflow-hidden" data-comparison-after>
              {{ after_image | image_url: width: 1000 | image_tag: class: 'absolute top-0 right-0 h-full max-w-none object-cover', widths: '480, 720, 1000', loading: 'lazy', alt: section.settings.after_label }}
            </div>
            <div class="absolute inset-y-0 left-1/2 w-px bg-white" data-comparison-divider><span class="absolute top-1/2 left-1/2 grid size-6 -translate-1/2 place-items-center rounded-full bg-white text-[10px] text-bitter-chocolate shadow">↕</span></div>
            <input class="absolute inset-0 size-full cursor-ew-resize opacity-0" type="range" min="0" max="100" value="50" aria-label="Compare before and after images" data-comparison-range>
            <span class="absolute bottom-3 left-3 rounded bg-black/55 px-2 py-1 text-[8px] tracking-[.8px] text-white uppercase">{{ section.settings.before_label | escape }}</span>
            <span class="absolute right-3 bottom-3 rounded bg-black/55 px-2 py-1 text-[8px] tracking-[.8px] text-white uppercase">{{ section.settings.after_label | escape }}</span>
          </div>
          {% if product.metafields.custom.efficacy_caption.value != blank %}<p class="mt-4 text-center text-xs leading-5 text-bitter-chocolate">{{ product.metafields.custom.efficacy_caption.value | escape }}</p>{% endif %}
        </section>
      {% endif %}

      {% comment %} Component: Product evidence accordions {% endcomment %}
      {% assign scientific_backing = product.metafields.custom.scientific_backing %}
      {% assign ethical_sourcing = product.metafields.custom.ethical_sourcing %}
      {% assign application_guide = product.metafields.custom.application_guide %}
      {% if scientific_backing != blank or ethical_sourcing != blank or application_guide != blank %}
        <div class="mt-10 border-b border-pecan-brown/15" data-pdp-accordions>
          {% if scientific_backing != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between py-4 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.scientific_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-5 text-sm leading-6 text-bitter-chocolate">{{ scientific_backing | metafield_tag }}</div></div></details>{% endif %}
          {% if ethical_sourcing != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between py-4 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.sourcing_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-5 text-sm leading-6 text-bitter-chocolate">{{ ethical_sourcing | metafield_tag }}</div></div></details>{% endif %}
          {% if application_guide != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between py-4 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.application_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-5 text-sm leading-6 text-bitter-chocolate">{{ application_guide | metafield_tag }}</div></div></details>{% endif %}
        </div>
      {% endif %}

    </div>
  </div>
  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
</section>
<script src="{{ 'product-detail.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product detail",
  "settings": [
    { "type": "text", "id": "collection_label", "label": "Fallback collection label", "default": "The Essence Collection" },
    { "type": "textarea", "id": "editorial_quote", "label": "Fallback editorial quote" },
    { "type": "text", "id": "select_label", "label": "Option heading prefix", "default": "Select" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold Out" },
    { "type": "text", "id": "in_stock_label", "label": "Available label", "default": "In Stock" },
    { "type": "text", "id": "gallery_marquee", "label": "Gallery marquee", "default": "Suitable for all skin types" },
    { "type": "text", "id": "ingredients_heading", "label": "Ingredients heading", "default": "Earth-Derived Actives" },
    { "type": "text", "id": "standards_eyebrow", "label": "Standards eyebrow", "default": "Our Standards" },
    { "type": "text", "id": "standards_heading", "label": "Standards heading", "default": "Certifications & Testing" }
    ,{ "type": "text", "id": "efficacy_heading", "label": "Efficacy heading", "default": "Proven Efficacy" }
    ,{ "type": "text", "id": "before_label", "label": "Before label", "default": "Day 0" }
    ,{ "type": "text", "id": "after_label", "label": "After label", "default": "Day 28" }
    ,{ "type": "text", "id": "scientific_heading", "label": "Scientific heading", "default": "Scientific Backing" }
    ,{ "type": "text", "id": "sourcing_heading", "label": "Sourcing heading", "default": "Ethical Sourcing" }
    ,{ "type": "text", "id": "application_heading", "label": "Application heading", "default": "Application Guide" }
  ],
  "presets": [{ "name": "Product detail" }]
}
{% endschema %}
