{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign collection_label = product.metafields.custom.collection_label.value | default: section.settings.collection_label
  assign editorial_quote = product.metafields.custom.editorial_quote.value | default: section.settings.editorial_quote
  assign ingredient_items = product.metafields.custom.ingredient_highlights.value | default: product.metafields.custom.ingredients.value
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
  assign standard_blocks = section.blocks | where: 'type', 'standard'
  assign efficacy_blocks = section.blocks | where: 'type', 'efficacy'
  assign evidence_blocks = section.blocks | where: 'type', 'evidence'
  assign ritual_blocks = section.blocks | where: 'type', 'ritual_step'
  assign ingredient_text_blocks = section.blocks | where: 'type', 'full_ingredients'
  assign timeline_blocks = section.blocks | where: 'type', 'timeline'
  assign product_standards = product.metafields.custom.standards.value
  assign ritual_items = product.metafields.custom.ritual_steps.value
  assign timeline_items = product.metafields.custom.timeline_milestones.value
  assign full_ingredients = product.metafields.custom.full_ingredients
  assign primary_form_id = 'ProductForm-' | append: section.id
%}

<section class="bg-[#f5ebe1] pb-14 lg:pb-20" data-main-product data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-checkout-label="{{ section.settings.floating_checkout_label | escape }}" data-sold-out-label="{{ section.settings.sold_out_label | escape }}">
  <div class="container mx-auto grid items-start gap-8 px-4 pt-5 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-8 lg:pt-10">
    {% comment %} Component: Sticky product gallery {% endcomment %}
    <div class="w-full" data-product-gallery data-reveal-group>
      <div class="relative aspect-[788/770] touch-pan-y overflow-hidden rounded-[20px] bg-[#eee6df] outline-none focus-visible:ring-2 focus-visible:ring-bitter-chocolate" data-gallery-stage tabindex="0" role="region" aria-label="Product gallery. Swipe or use arrow keys to change media">
        {% if product.media.size > 0 %}{% for media in product.media %}
          <div class="absolute inset-0 transition-opacity duration-300 {% unless media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}pointer-events-none opacity-0{% endunless %}" data-media-id="{{ media.id }}" {% unless media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}hidden{% endunless %}>
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 1600 | image_tag: class: 'size-full object-cover', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 1024px) 55vw, 100vw', loading: 'eager', alt: media.alt | default: product.title }}
              {% when 'video' %}{{ media | media_tag: image_size: '1200x', autoplay: false, loop: true, controls: true, class: 'size-full object-cover' }}
              {% when 'external_video' %}{{ media | external_video_tag: class: 'size-full' }}
              {% when 'model' %}{{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'size-full' }}
            {% endcase %}
          </div>
        {% endfor %}{% else %}<div class="grid size-full place-items-center text-sm text-bitter-chocolate/60">{{ 'product-1' | placeholder_svg_tag: 'size-full' }}</div>{% endif %}
        <div class="absolute inset-x-0 bottom-0 overflow-hidden bg-[#5a2e2c]/90 py-2.5 text-white backdrop-blur-lg" aria-hidden="true">
          <div class="pdp-marquee flex w-max gap-10 whitespace-nowrap text-[10px] font-semibold tracking-[2.5px] uppercase">
            {% for i in (1..8) %}<span>{{ section.settings.gallery_marquee | escape }}</span>{% endfor %}
          </div>
        </div>
      </div>
      {% if product.media.size > 1 %}
        <div class="mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="list" aria-label="Product media" data-gallery-thumbnails>
          {% for media in product.media %}
            <button class="aspect-[185/137] w-[calc((100%_-_3rem)/4)] min-w-[calc((100%_-_3rem)/4)] snap-start overflow-hidden rounded-[20px] border-2 bg-[#eee6df] transition focus:outline-none focus-visible:ring-2 focus-visible:ring-bitter-chocolate {% if media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}border-bitter-chocolate{% else %}border-transparent opacity-70 hover:opacity-100{% endif %}" type="button" data-gallery-thumb="{{ media.id }}" aria-label="Show media {{ forloop.index }} of {{ product.media.size }}" aria-pressed="{% if media.id == current_variant.featured_media.id or current_variant.featured_media == blank and forloop.first %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 420 | image_tag: class: 'size-full object-cover', widths: '180, 300, 420', loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% comment %} Component: Product purchase and editorial content {% endcomment %}
    <div class="min-w-0" data-product-content>
      <div class="grid gap-4" data-reveal-group>
        {% if collection_label != blank %}<p class="text-xs font-semibold leading-[15px] tracking-[1px] text-bitter-chocolate uppercase">{{ collection_label | escape }}</p>{% endif %}
        <h1 class="font-display text-[40px] leading-none font-normal text-text-brown lg:text-[48px]">{{ product.title | escape }}</h1>
        <div class="flex items-center gap-4">
          <span class="text-xl font-medium tracking-[1px]" data-product-price>{{ current_variant.price | money }}</span>
          <s class="text-sm text-bitter-chocolate/55" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        </div>
        {% if editorial_quote != blank %}<p class="pb-2 text-base leading-7 italic text-bitter-chocolate">“{{ editorial_quote | remove: '“' | remove: '”' | remove: '"' }}”</p>{% endif %}
        {% if product.description != blank %}<div class="rte text-sm leading-6 text-bitter-chocolate/85" data-product-description>{{ product.description }}</div>{% endif %}
      </div>

      {% form 'product', product, id: primary_form_id, class: 'mt-4 grid gap-8', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1" data-form-quantity>

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="order-2" data-option-group data-option-index="{{ forloop.index0 }}" data-reveal-group>
              <legend class="mb-3 text-xs font-medium tracking-[1.5px] uppercase">{{ section.settings.select_label }} {{ option.name | escape }}</legend>
              <div class="flex flex-wrap gap-3">
                {% for value in option.values %}
                  {% assign option_selected = false %}
                  {% if value == option.selected_value %}{% assign option_selected = true %}{% endif %}
                  {% assign option_downcase = option.name | downcase %}
                  {% if option_downcase contains 'color' or option_downcase contains 'colour' or option_downcase contains 'shade' %}
                    {% assign swatch_color = value.swatch.color | default: '#c9a68e' %}
                    <button class="pdp-option pdp-swatch grid justify-items-center gap-1.5 text-[11px] tracking-[.8px] uppercase {% if option_selected %}is-selected{% endif %}" type="button" data-option-value="{{ value | escape }}" aria-pressed="{{ option_selected }}"><span class="grid size-11 place-items-center rounded-full border-2 {% if option_selected %}border-bitter-chocolate{% else %}border-transparent{% endif %}" data-swatch-ring><span class="size-8 rounded-full border border-pecan-brown/30" style="background-color: {{ swatch_color }}" aria-hidden="true"></span></span><span>{{ value | escape }}</span></button>
                  {% else %}
                    <button class="pdp-option min-h-12 min-w-28 rounded-full border-2 px-6 text-xs font-semibold tracking-[1px] uppercase {% if option_selected %}is-selected border-bitter-chocolate bg-pecan-brown/5{% else %}border-toasted-almond text-bitter-chocolate{% endif %}" type="button" data-option-value="{{ value | escape }}" aria-pressed="{{ option_selected }}">{{ value | escape }}</button>
                  {% endif %}
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}

        <div class="order-1 flex flex-wrap items-center gap-3" data-primary-purchase data-reveal-group>
          <div class="flex h-11 items-center rounded-full border border-toasted-almond px-3" data-quantity-control>
            <button class="grid size-7 place-items-center" type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
            <output class="w-8 text-center text-sm font-semibold" data-quantity-output>1</output>
            <button class="grid size-7 place-items-center" type="button" data-quantity-plus aria-label="Increase quantity">+</button>
          </div>
          <button class="grid size-11 shrink-0 cursor-not-allowed place-items-center rounded-full border-2 border-bitter-chocolate/70 text-lg" type="button" disabled aria-label="Wishlist unavailable" title="Wishlist coming soon">♡</button>
          <button class="chrome-action relative h-11 min-w-32 flex-1 overflow-hidden rounded-full border-2 border-bitter-chocolate bg-transparent px-4 text-[10px] font-bold tracking-[1.1px] text-bitter-chocolate uppercase disabled:cursor-not-allowed disabled:opacity-50" type="submit" name="add" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}><span class="relative z-10" data-add-label>{% if current_variant.available %}{{ section.settings.add_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span></button>
          <div class="shopify-payment-button-wrap min-w-36 flex-1">{{ form | payment_button }}</div>
        </div>
        <p class="sr-only" data-inventory-status>{% if current_variant.available %}{{ section.settings.in_stock_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</p>
      {% endform %}

      {% comment %} Component: Ingredient highlights {% endcomment %}
      {% assign show_ingredient_blocks = false %}{% for block in ingredient_blocks %}{% if block.settings.product.handle == product.handle %}{% assign show_ingredient_blocks = true %}{% endif %}{% endfor %}
      {% if ingredient_items != blank or show_ingredient_blocks %}<section class="mt-10" data-reveal-group>
        <div class="border-b border-pecan-brown/15 pb-4"><h2 class="font-display text-3xl font-light">{{ section.settings.ingredients_heading | escape }}</h2></div>
        <div class="mt-5 grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-4">
          {% if ingredient_items != blank %}
            {% for ingredient in ingredient_items limit: 4 %}
              {% assign ingredient_image = ingredient.card_image.value | default: ingredient.image.value %}
              <article class="min-w-0 text-center"><div class="mx-auto grid size-20 place-items-center overflow-hidden rounded-full bg-[#f1ddcc]">{% if ingredient_image != blank %}{{ ingredient_image | image_url: width: 240 | image_tag: class: 'size-full object-cover', loading: 'lazy', alt: ingredient.image_alt.value | default: ingredient.name.value }}{% endif %}</div><h3 class="mt-3 text-[11px] leading-4 font-bold tracking-[.65px] uppercase">{{ ingredient.name.value | default: ingredient.system.handle | escape }}</h3><p class="mt-0.5 text-[9px] leading-4 tracking-[.45px] text-bitter-chocolate uppercase">{{ ingredient.summary.value | truncatewords: 7 }}</p></article>
            {% endfor %}
          {% else %}
            {% assign ingredient_block_index = 0 %}{% for block in ingredient_blocks %}{% if block.settings.product.handle == product.handle and ingredient_block_index < 4 %}{% assign ingredient_block_index = ingredient_block_index | plus: 1 %}
              <article class="min-w-0 text-center" {{ block.shopify_attributes }}>
                <div class="mx-auto grid size-20 place-items-center overflow-hidden rounded-full bg-[#f1ddcc] text-bitter-chocolate">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 240 | image_tag: class: 'size-full object-cover', loading: 'lazy', alt: block.settings.name }}
                  {% else %}
                    {% case block.settings.icon %}
                      {% when 'sparkles' %}<svg class="size-9" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 5c.7 6.7 3.5 9.5 10 10-6.5.7-9.3 3.5-10 10-.7-6.5-3.5-9.3-10-10 6.5-.5 9.3-3.3 10-10Z" stroke="currentColor" stroke-width="2"/><path d="M31 23c.3 3 1.7 4.4 4.8 4.8-3.1.3-4.5 1.7-4.8 4.7-.4-3-1.8-4.4-4.8-4.7 3-.4 4.4-1.8 4.8-4.8ZM9 24c.3 2.4 1.4 3.5 3.8 3.8-2.4.3-3.5 1.4-3.8 3.8-.3-2.4-1.4-3.5-3.8-3.8 2.4-.3 3.5-1.4 3.8-3.8Z" fill="currentColor"/></svg>
                      {% when 'drop' %}<svg class="size-9" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 6S10 17.3 10 24a10 10 0 0 0 20 0C30 17.3 20 6 20 6Z" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 25.5a5 5 0 0 0 5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                      {% when 'radiance' %}<svg class="size-9" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="m20 5 4.2 4.2 6-.2-.2 6 4.2 4.2-4.2 4.2.2 6-6-.2L20 33.5l-4.2-4.3-6 .2.2-6-4.2-4.2L10 15l-.2-6 6 .2L20 5Z" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="19.2" r="6" stroke="currentColor" stroke-width="2"/></svg>
                      {% else %}<svg class="size-9" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M30.5 10.5C19 9.8 10.5 15.8 10.5 24c0 4.2 3.2 6.5 6.8 6.5 8.3 0 13.7-8.2 13.2-20Z" stroke="currentColor" stroke-width="2.2"/><path d="M11.5 30c4-7.2 8-10.8 14.5-14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {% endcase %}
                  {% endif %}
                </div>
                <h3 class="mt-3 text-[11px] leading-4 font-bold tracking-[.65px] uppercase">{{ block.settings.name | escape }}</h3>
                <p class="mt-0.5 text-[9px] leading-4 tracking-[.45px] text-bitter-chocolate uppercase">{{ block.settings.summary | escape }}</p>
              </article>
            {% endif %}{% endfor %}
          {% endif %}
        </div>
      </section>{% endif %}

      {% comment %} Component: Certifications and testing {% endcomment %}
      {% assign show_standards = false %}
      {% for block in standard_blocks %}{% if block.settings.product == product %}{% assign show_standards = true %}{% endif %}{% endfor %}
      {% if product_standards != blank or show_standards %}<section class="mt-10 border-t border-pecan-brown/15 pt-10" data-reveal-group>
        <p class="text-xs font-semibold tracking-[1.5px] text-bitter-chocolate uppercase">{{ section.settings.standards_eyebrow | escape }}</p>
        <h2 class="mt-2 font-display text-[34px] leading-[42px] font-normal">{{ section.settings.standards_heading | escape }}</h2>
        <div class="mt-7 grid grid-cols-2 gap-x-7 gap-y-6">
          {% if product_standards != blank %}
            {% for standard in product_standards %}{% assign standard_icon = standard.icon.value %}<div class="flex items-center gap-2"><span class="grid size-8 shrink-0 place-items-center overflow-hidden rounded-full border border-toasted-almond text-xs">{% if standard_icon != blank %}{{ standard_icon | image_url: width: 64 | image_tag: class: 'size-4 object-contain', loading: 'lazy', alt: '' }}{% else %}✓{% endif %}</span><span class="text-[11px]">{{ standard.label.value | default: standard }}</span></div>{% endfor %}
          {% else %}
            {% for block in standard_blocks %}{% if block.settings.product == product %}<div class="flex items-center gap-2" {{ block.shopify_attributes }}><span class="grid size-8 shrink-0 place-items-center rounded-full border border-toasted-almond text-xs" aria-hidden="true">{{ block.settings.symbol | default: '✓' }}</span><span class="text-[11px]">{{ block.settings.label | escape }}</span></div>{% endif %}{% endfor %}
          {% endif %}
        </div>
        {% assign standards_note = product.metafields.custom.standards_note.value | default: section.settings.standards_note %}
        {% if standards_note != blank %}<p class="mt-7 text-[9px] leading-4 font-medium tracking-[.4px] text-pecan-brown uppercase">{{ standards_note | escape }}</p>{% endif %}
      </section>{% endif %}

      {% comment %} Component: Proven efficacy {% endcomment %}
      {% assign before_image = product.metafields.custom.before_image.value %}
      {% assign after_image = product.metafields.custom.after_image.value %}
      {% for block in efficacy_blocks %}{% if block.settings.product == product %}{% assign before_image = before_image | default: block.settings.before_image %}{% assign after_image = after_image | default: block.settings.after_image %}{% assign efficacy_caption = product.metafields.custom.efficacy_caption.value | default: block.settings.caption %}{% endif %}{% endfor %}
      {% assign before_image = before_image | default: product.media[3].preview_image %}
      {% assign after_image = after_image | default: product.media[4].preview_image %}
      {% if before_image != blank and after_image != blank %}
        <section class="mt-12 border-t border-pecan-brown/15 pt-10" data-reveal-group>
          <h2 class="font-display text-[34px] leading-[42px] font-normal">{{ section.settings.efficacy_heading | escape }}</h2>
          <div class="relative mt-5 aspect-[2/1] overflow-hidden rounded-xl bg-[#eee6df]" data-comparison>
            {{ before_image | image_url: width: 1000 | image_tag: class: 'absolute inset-0 size-full object-cover', widths: '480, 720, 1000', loading: 'lazy', alt: section.settings.before_label }}
            <div class="absolute inset-y-0 right-0 w-1/2 overflow-hidden" data-comparison-after>
              {{ after_image | image_url: width: 1000 | image_tag: class: 'absolute top-0 right-0 h-full max-w-none object-cover', widths: '480, 720, 1000', loading: 'lazy', alt: section.settings.after_label }}
            </div>
            <div class="absolute inset-y-0 left-1/2 w-px bg-white" data-comparison-divider><span class="absolute top-1/2 left-1/2 grid size-6 -translate-1/2 place-items-center rounded-full bg-white text-[10px] text-bitter-chocolate shadow">↕</span></div>
            <input class="absolute inset-0 size-full cursor-ew-resize opacity-0" type="range" min="0" max="100" value="50" aria-label="Compare before and after images" data-comparison-range>
            <span class="absolute bottom-3 left-3 rounded bg-black/55 px-2 py-1 text-[8px] tracking-[.8px] text-white uppercase">{{ section.settings.before_label | escape }}</span>
            <span class="absolute right-3 bottom-3 rounded bg-black/55 px-2 py-1 text-[8px] tracking-[.8px] text-white uppercase">{{ section.settings.after_label | escape }}</span>
          </div>
          {% if efficacy_caption != blank %}<p class="mt-4 text-center text-[11px] leading-5 text-bitter-chocolate">{{ efficacy_caption | escape }}</p>{% endif %}
        </section>
      {% endif %}

      {% comment %} Component: Product evidence accordions {% endcomment %}
      {% assign scientific_backing = product.metafields.custom.scientific_backing %}
      {% assign ethical_sourcing = product.metafields.custom.ethical_sourcing %}
      {% assign show_evidence = false %}{% for block in evidence_blocks %}{% if block.settings.product == product %}{% assign show_evidence = true %}{% endif %}{% endfor %}
      {% assign show_ritual = false %}{% for block in ritual_blocks %}{% if block.settings.product == product %}{% assign show_ritual = true %}{% endif %}{% endfor %}
      {% assign show_full_ingredients = false %}{% for block in ingredient_text_blocks %}{% if block.settings.product == product %}{% assign show_full_ingredients = true %}{% endif %}{% endfor %}
      {% if scientific_backing != blank or ethical_sourcing != blank or ritual_items != blank or full_ingredients != blank or show_evidence or show_ritual or show_full_ingredients %}
        <div class="mt-10 border-b border-pecan-brown/15" data-pdp-accordions>
          {% if scientific_backing != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between py-4 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.scientific_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-5 text-sm leading-6 text-bitter-chocolate">{{ scientific_backing | metafield_tag }}</div></div></details>{% endif %}
          {% if ethical_sourcing != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between py-4 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.sourcing_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-5 text-sm leading-6 text-bitter-chocolate">{{ ethical_sourcing | metafield_tag }}</div></div></details>{% endif %}
          {% if scientific_backing == blank and ethical_sourcing == blank %}{% for block in evidence_blocks %}{% if block.settings.product == product %}<details class="pdp-accordion border-t border-pecan-brown/15" {{ block.shopify_attributes }}><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between py-4 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ block.settings.heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="rte pb-5 text-sm leading-6 text-bitter-chocolate">{{ block.settings.content }}</div></div></details>{% endif %}{% endfor %}{% endif %}
          {% if ritual_items != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-[69px] cursor-pointer list-none items-center justify-between py-6 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.application_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-6"><h3 class="font-display text-[34px] leading-[42px]">{{ section.settings.ritual_heading | escape }}</h3><p class="mt-1 text-xs tracking-[1px] uppercase">{{ section.settings.ritual_subheading | escape }}</p><ol class="mt-8 grid gap-7">{% for step in ritual_items %}<li class="grid grid-cols-[2.5rem_1fr] gap-4"><span class="font-display text-[34px] leading-10">0{{ forloop.index }}</span><div><h4 class="text-lg font-medium">{{ step.heading.value | escape }}</h4><div class="mt-1 text-sm leading-6 text-bitter-chocolate">{{ step.description.value }}</div></div></li>{% endfor %}</ol></div></div></details>{% endif %}
          {% if ritual_items == blank and show_ritual %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-[69px] cursor-pointer list-none items-center justify-between py-6 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.application_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-6"><h3 class="font-display text-[34px] leading-[42px]">{{ section.settings.ritual_heading | escape }}</h3><p class="mt-1 text-xs tracking-[1px] uppercase">{{ section.settings.ritual_subheading | escape }}</p><ol class="mt-7 grid gap-6">{% assign ritual_index = 0 %}{% for block in ritual_blocks %}{% if block.settings.product == product %}{% assign ritual_index = ritual_index | plus: 1 %}<li class="grid grid-cols-[2.5rem_1fr] gap-4" {{ block.shopify_attributes }}><span class="font-display text-[30px] leading-9">0{{ ritual_index }}</span><div><h4 class="text-base font-medium">{{ block.settings.heading | escape }}</h4><div class="mt-1 text-sm leading-6 text-bitter-chocolate">{{ block.settings.description }}</div></div></li>{% endif %}{% endfor %}</ol></div></div></details>{% endif %}
          {% if full_ingredients != blank %}<details class="pdp-accordion border-t border-pecan-brown/15"><summary class="flex min-h-[69px] cursor-pointer list-none items-center justify-between py-6 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.full_ingredients_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="pb-6 text-sm leading-6 text-bitter-chocolate">{{ full_ingredients | metafield_tag }}</div></div></details>{% endif %}
          {% if full_ingredients == blank %}{% for block in ingredient_text_blocks %}{% if block.settings.product == product %}<details class="pdp-accordion border-t border-pecan-brown/15" {{ block.shopify_attributes }}><summary class="flex min-h-[69px] cursor-pointer list-none items-center justify-between py-6 text-xs font-semibold tracking-[1.2px] uppercase [&::-webkit-details-marker]:hidden"><span>{{ section.settings.full_ingredients_heading | escape }}</span><span class="pdp-accordion__icon" aria-hidden="true">⌄</span></summary><div class="pdp-accordion__body"><div class="rte pb-6 text-sm leading-6 text-bitter-chocolate">{{ block.settings.content }}</div></div></details>{% endif %}{% endfor %}{% endif %}
        </div>
      {% endif %}

      {% comment %} Component: Transformation timeline {% endcomment %}
      {% assign show_timeline = false %}{% for block in timeline_blocks %}{% if block.settings.product == product %}{% assign show_timeline = true %}{% endif %}{% endfor %}
      {% if timeline_items != blank or show_timeline %}<section class="mt-16" data-reveal-group>
        <div class="text-center"><h2 class="font-display text-[34px] leading-[42px]">{{ section.settings.timeline_heading | escape }}</h2><span class="mx-auto mt-4 block h-0.5 w-12 bg-bitter-chocolate"></span></div>
        <div class="pdp-timeline relative mt-16 grid gap-16">
          {% for milestone in timeline_items %}
            <article class="pdp-timeline__item grid grid-cols-2 items-center gap-12 {% if forloop.index == 2 %}is-reversed{% endif %}">
              <div class="pdp-timeline__badge justify-self-end rounded-full bg-[linear-gradient(135deg,#2d1f1e,#9b685b_50%,#4e3b37)] px-4 py-2 text-[10px] tracking-[1px] text-white uppercase">{{ milestone.period.value | escape }}</div>
              <div><h3 class="text-lg font-medium">{{ milestone.heading.value | escape }}</h3>{% assign benefits = milestone.benefits.value %}{% if benefits != blank %}<ul class="mt-2 grid gap-1 text-sm leading-5 text-bitter-chocolate">{% for benefit in benefits %}<li class="flex gap-2"><span aria-hidden="true">•</span><span>{{ benefit | escape }}</span></li>{% endfor %}</ul>{% elsif milestone.description.value != blank %}<div class="mt-2 text-sm leading-5 text-bitter-chocolate">{{ milestone.description.value }}</div>{% endif %}</div>
            </article>
          {% endfor %}
          {% if timeline_items == blank %}{% assign timeline_index = 0 %}{% for block in timeline_blocks %}{% if block.settings.product == product %}{% assign timeline_index = timeline_index | plus: 1 %}<article class="pdp-timeline__item grid grid-cols-2 items-center gap-12 {% if timeline_index == 2 %}is-reversed{% endif %}" {{ block.shopify_attributes }}><div class="pdp-timeline__badge justify-self-end rounded-full bg-[linear-gradient(135deg,#2d1f1e,#9b685b_50%,#4e3b37)] px-4 py-2 text-[10px] tracking-[1px] text-white uppercase">{{ block.settings.period | escape }}</div><div><h3 class="text-lg font-medium">{{ block.settings.heading | escape }}</h3><div class="mt-2 text-sm leading-5 text-bitter-chocolate">{{ block.settings.description }}</div></div></article>{% endif %}{% endfor %}{% endif %}
        </div>
      </section>{% endif %}

    </div>
  </div>

  {% comment %} Component: Persistent floating purchase bar {% endcomment %}
  <div class="pointer-events-none fixed inset-x-0 bottom-8 z-50 translate-y-5 opacity-0" data-floating-cart aria-hidden="true">
    <div class="container mx-auto px-4">
      <div class="mx-auto flex min-h-16 w-full max-w-[896px] items-center justify-between gap-3 rounded-full border border-pecan-brown/10 bg-white/95 py-2 pr-2 pl-5 shadow-[0_25px_50px_-12px_rgb(0_0_0/25%)] backdrop-blur-2xl lg:min-h-[74px] lg:py-3 lg:pr-4 lg:pl-[22px]">
        <div class="flex min-w-0 items-center gap-4 lg:px-2">
          <div class="min-w-0">
            <p class="truncate text-[10px] leading-4 tracking-[1.1px] text-bitter-chocolate uppercase lg:text-xs lg:leading-5">{{ product.title | escape }}</p>
            <p class="text-sm leading-5 font-semibold tracking-[1px] text-text-brown uppercase lg:text-base" data-floating-price>{{ current_variant.price | money }}</p>
          </div>
          <span class="hidden h-10 w-px bg-pecan-brown/10 sm:block" aria-hidden="true"></span>
          <div class="hidden items-center gap-3 sm:flex">
            <img class="size-3 shrink-0" src="{{ '47-6899.svg' | asset_url }}" width="12" height="12" alt="">
            <span class="whitespace-nowrap text-[10px] leading-5 tracking-[1.1px] text-text-brown uppercase lg:text-xs" data-floating-stock>{% if current_variant.available %}{{ section.settings.in_stock_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-2 lg:gap-4">
          <button class="chrome-action relative h-12 min-w-32 overflow-hidden rounded-full bg-[linear-gradient(135deg,#2d1f1e,#9b685b_50%,#4e3b37)] px-6 text-xs font-bold tracking-[1.4px] text-[#f4dfb8] uppercase shadow-[inset_0_1px_0_rgb(255_255_255/40%),0_4px_6px_-1px_rgb(166_114_105/30%)] disabled:cursor-not-allowed disabled:opacity-50 lg:min-w-[165px] lg:px-8 lg:text-sm" type="button" data-floating-add {% unless current_variant.available %}disabled{% endunless %}><span class="relative z-10" data-floating-add-label>{% if current_variant.available %}{{ section.settings.floating_checkout_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</span></button>
          <button class="grid size-12 cursor-not-allowed place-items-center rounded-full border-[1.5px] border-bitter-chocolate shadow-[0_8px_10px_-6px_rgb(212_108_17/20%),0_20px_25px_-5px_rgb(212_108_17/20%)]" type="button" disabled aria-label="Wishlist unavailable" title="Wishlist coming soon"><img src="{{ '56-9281.svg' | asset_url }}" class="h-5 w-[22px]" width="22" height="20" alt=""></button>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
</section>
<script src="{{ 'product-detail.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product detail",
  "settings": [
    { "type": "text", "id": "collection_label", "label": "Fallback collection label", "default": "The Essence Collection" },
    { "type": "textarea", "id": "editorial_quote", "label": "Fallback editorial quote" },
    { "type": "text", "id": "select_label", "label": "Option heading prefix", "default": "Select" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to Cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold Out" },
    { "type": "text", "id": "in_stock_label", "label": "Available label", "default": "In Stock" },
    { "type": "text", "id": "floating_checkout_label", "label": "Floating checkout button", "default": "Checkout" },
    { "type": "text", "id": "gallery_marquee", "label": "Gallery marquee", "default": "Suitable for all skin types" },
    { "type": "text", "id": "ingredients_heading", "label": "Ingredients heading", "default": "Earth-Derived Actives" },
    { "type": "text", "id": "standards_eyebrow", "label": "Standards eyebrow", "default": "Our Standards" },
    { "type": "text", "id": "standards_heading", "label": "Standards heading", "default": "Certifications & Testing" },
    { "type": "textarea", "id": "standards_note", "label": "Fallback standards note", "default": "*Identical strain, formerly known as Bifidobacterium adolescentis SD-BA5-IT" }
    ,{ "type": "text", "id": "efficacy_heading", "label": "Efficacy heading", "default": "Proven Efficacy" }
    ,{ "type": "text", "id": "before_label", "label": "Before label", "default": "Day 0" }
    ,{ "type": "text", "id": "after_label", "label": "After label", "default": "Day 28" }
    ,{ "type": "text", "id": "scientific_heading", "label": "Scientific heading", "default": "Scientific Backing" }
    ,{ "type": "text", "id": "sourcing_heading", "label": "Sourcing heading", "default": "Ethical Sourcing" }
    ,{ "type": "text", "id": "application_heading", "label": "Application heading", "default": "Application Guide" }
    ,{ "type": "text", "id": "ritual_heading", "label": "Ritual heading", "default": "The Ritual" }
    ,{ "type": "text", "id": "ritual_subheading", "label": "Ritual subheading", "default": "A mindful application guide" }
    ,{ "type": "text", "id": "full_ingredients_heading", "label": "Full ingredients heading", "default": "Full Ingredients" }
    ,{ "type": "text", "id": "timeline_heading", "label": "Timeline heading", "default": "Timeline of Transformation" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient highlight",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "leaf", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "sparkles", "label": "Sparkles" },
          { "value": "drop", "label": "Drop" },
          { "value": "radiance", "label": "Radiance" }
        ] },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "summary", "label": "Benefit" }
      ]
    },
    {
      "type": "standard",
      "name": "Product standard",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "symbol", "label": "Short symbol", "default": "✓" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "efficacy",
      "name": "Product efficacy",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "before_image", "label": "Before image" },
        { "type": "image_picker", "id": "after_image", "label": "After image" },
        { "type": "textarea", "id": "caption", "label": "Result caption" }
      ]
    },
    {
      "type": "evidence",
      "name": "Evidence accordion",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "ritual_step",
      "name": "Application step",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "full_ingredients",
      "name": "Full ingredients",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "richtext", "id": "content", "label": "Ingredient list" }
      ]
    },
    {
      "type": "timeline",
      "name": "Timeline milestone",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "period", "label": "Period" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Product detail" }]
}
{% endschema %}
