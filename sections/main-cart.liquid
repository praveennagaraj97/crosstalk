{% comment %} Component: Native cart page {% endcomment %}
{% liquid
  assign continue_url = routes.all_products_collection_url
  if section.settings.continue_collection != blank
    assign continue_url = section.settings.continue_collection.url
  endif
  assign recommendations = section.settings.recommendations_collection
  if recommendations == blank
    assign recommendations = collections.all
  endif
%}
<section class="main-cart bg-background py-10 sm:py-14 lg:py-18" aria-labelledby="MainCartTitle-{{ section.id }}">
  <div class="container mx-auto px-4">
    {% if cart.item_count == 0 %}
      <header class="main-cart__empty-header" data-reveal>
        <h1 id="MainCartTitle-{{ section.id }}" class="main-cart__empty-title">{{ section.settings.empty_page_heading | escape }}</h1>
        <p>{{ section.settings.empty_page_copy | escape }}</p>
      </header>
      {% render 'empty-cart-state', heading: section.settings.empty_heading, copy: section.settings.empty_copy, action_label: section.settings.continue_label, action_url: continue_url, image: section.settings.empty_image %}

      {% if recommendations.products_count > 0 %}
        <section class="cart-recommendations" aria-labelledby="CartRecommendationsTitle-{{ section.id }}" data-reveal-group>
          <header class="cart-recommendations__header">
            <h2 id="CartRecommendationsTitle-{{ section.id }}">{{ section.settings.recommendations_heading | escape }}</h2>
            <a href="{{ recommendations.url }}">{{ section.settings.view_all_label | escape }}</a>
          </header>
          <div class="cart-recommendations__grid">
            {% for recommendation in recommendations.products limit: 4 %}
              <article class="cart-recommendations__card">
                <a class="cart-recommendations__media" href="{{ recommendation.url }}">
                  {% if recommendation.featured_image != blank %}{{ recommendation.featured_image | image_url: width: 720 | image_tag: class: 'size-full object-cover transition-transform duration-500 group-hover:scale-[1.025]', widths: '240, 360, 540, 720', loading: 'lazy', alt: recommendation.featured_image.alt | default: recommendation.title }}{% endif %}
                </a>
                <h3><a href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a></h3>
                <p>{{ recommendation.price | money }}</p>
              </article>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    {% else %}
      <header class="main-cart__header" data-reveal>
        <div>
          <p class="main-cart__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h1 id="MainCartTitle-{{ section.id }}" class="main-cart__title">{{ section.settings.heading | escape }}</h1>
        </div>
        <span class="main-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}Item{% else %}Items{% endif %}</span>
      </header>

      <form action="{{ routes.cart_url }}" method="post" class="main-cart__layout" data-reveal-group>
        <div class="main-cart__items">
          {% for item in cart.items %}
            <article class="main-cart__item">
              <a class="main-cart__media" href="{{ item.url }}">
                {% if item.image != blank %}{{ item.image | image_url: width: 320 | image_tag: class: 'size-full object-cover mix-blend-multiply', widths: '140, 220, 320', loading: 'eager', alt: item.product.title }}{% endif %}
              </a>
              <div class="main-cart__item-body">
                <div>
                  <h2 class="main-cart__item-title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                  {% unless item.product.has_only_default_variant %}<p class="main-cart__variant">{{ item.variant.title | escape }}</p>{% endunless %}
                </div>
                <div class="main-cart__item-footer">
                  <label class="main-cart__quantity">
                    <span class="visually-hidden">Quantity for {{ item.product.title | escape }}</span>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
                  </label>
                  <strong>{{ item.final_line_price | money }}</strong>
                  <a class="main-cart__remove" href="{{ item.url_to_remove }}">{{ section.settings.remove_label | escape }}</a>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        <aside class="main-cart__summary">
          <div class="flex items-center justify-between"><span>{{ section.settings.subtotal_label | escape }}</span><strong>{{ cart.total_price | money }}</strong></div>
          <p>{{ section.settings.shipping_note | escape }}</p>
          <button class="chrome-action main-cart__checkout" type="submit" name="checkout"><span class="relative z-10">{{ section.settings.checkout_label | escape }}</span></button>
          <button class="main-cart__update" type="submit" name="update">{{ section.settings.update_label | escape }}</button>
        </aside>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Cart" },
    { "type": "text", "id": "empty_page_heading", "label": "Empty page heading", "default": "Your Ritual Bag" },
    { "type": "text", "id": "empty_page_copy", "label": "Empty page subheading", "default": "You have no items in your bag." },
    { "type": "image_picker", "id": "empty_image", "label": "Empty cart background" },
    { "type": "text", "id": "empty_heading", "label": "Empty panel heading", "default": "Your ritual bag is currently empty" },
    { "type": "textarea", "id": "empty_copy", "label": "Empty panel copy", "default": "Start your journey to glowing skin by discovering our curated botanical collections." },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Start Shopping" },
    { "type": "collection", "id": "continue_collection", "label": "Continue shopping collection" },
    { "type": "header", "content": "Recommendations" },
    { "type": "text", "id": "recommendations_heading", "label": "Heading", "default": "Recommended for your ritual" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All" },
    { "type": "collection", "id": "recommendations_collection", "label": "Products collection" },
    { "type": "text", "id": "remove_label", "label": "Remove label", "default": "Remove" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Shipping and returns are calculated at checkout." },
    { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "Checkout" },
    { "type": "text", "id": "update_label", "label": "Update label", "default": "Update Cart" }
  ]
}
{% endschema %}
