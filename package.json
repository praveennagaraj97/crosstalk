{
  "name": "crosstalk-shopify-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev:css": "tailwindcss -i ./assets/base.css -o ./assets/theme.css --watch",
    "build:css": "tailwindcss -i ./assets/base.css -o ./assets/theme.css --minify",
    "check:css": "tmpfile=$(mktemp); trap 'rm -f \"$tmpfile\"' EXIT; tailwindcss -i ./assets/base.css -o \"$tmpfile\" --minify && cmp -s \"$tmpfile\" ./assets/theme.css",
    "check": "npm run check:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "concurrently": "10.0.5",
    "tailwindcss": "4.3.3"
  }
}
